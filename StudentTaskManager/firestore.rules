rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validTask(data) {
      return data.keys().hasAll([
          'title',
          'description',
          'completed',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'title',
          'subject',
          'description',
          'completed',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && (!data.keys().hasAny(['subject'])
          || (data.subject is string
            && data.subject.size() > 0
            && data.subject.size() <= 120))
        && data.description is string
        && data.description.size() <= 2000
        && data.completed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/tasks/{taskId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && validTask(request.resource.data);
      allow update: if isOwner(userId)
        && validTask(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
